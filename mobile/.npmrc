# pnpm configuration for mobile project

# Registry configuration
registry=https://registry.npmjs.org/

# Performance and behavior
# Fetch from network if package not found in store
fetch-timeout=60000

# Authentication (uncomment and set if using private registries)
# //registry.example.com/:_authToken=YOUR_TOKEN

# NPM scripts behavior
# Run scripts with specific shell
script-shell=/bin/bash

# Save exact versions (no ^ or ~ modifiers)
save-exact=false

# Link local packages
link-workspace-packages=true

# Hoisting behavior for node_modules
# hoist-pattern=[@,!@my-org/pkg]

# Filter for package hoisting
hoisting-strategy=auto

# Store configuration
store-dir=node_modules/.pnpm

# Lock file behavior
# Prefer frozen-lockfile in CI
frozen-lockfile=false

# Optional peer dependencies
optional-dependencies=true

# Git configuration for dependencies
git-checks=true

# Security and audit
# audit-level=moderate
